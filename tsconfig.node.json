{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // Ana işlem Electron 22 = Node 16.17: DOM tipleri yok, @types/node@16 →
    // global fetch / AbortSignal.timeout / structuredClone gibi API'ler derlemede hata verir
    "lib": ["ES2021"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/common/**/*.ts",
    "electron.vite.config.ts",
    "vite.config.ts",
    "vite.mobile.config.ts"
  ]
}
